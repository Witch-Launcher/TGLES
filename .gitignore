# TGL .gitignore — keep sources + docs + screenshots, drop everything generated.

# CMake / build trees (in-source or out-of-source).
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
Testing/
/plan/

# Headless trial frame dumps (regenerable; PNG illustrations in
# assets/screenshots/ ARE committed).
*.ppm

# Xcode / Apple.
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# macOS Finder noise.
.DS_Store
.AppleDouble
.LSOverride
._*

# Python helpers (docs preview scripts, converters).
__pycache__/
*.py[cod]
.venv/

# Node (local docsify serve).
node_modules/
